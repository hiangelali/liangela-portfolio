{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/dropbox-esignature",
      "destination": "/dropbox-sign",
      "permanent": true
    },
    {
      "source": "/dropbox-esignature/",
      "destination": "/dropbox-sign/",
      "permanent": true
    },
    {
      "source": "/airbnbcohosting",
      "destination": "/airbnb-cohosting",
      "permanent": true
    },
    {
      "source": "/airbnbcohosting/",
      "destination": "/airbnb-cohosting/",
      "permanent": true
    },
    {
      "source": "/clearerfees",
      "destination": "/clearer-fees",
      "permanent": true
    },
    {
      "source": "/clearerfees/",
      "destination": "/clearer-fees/",
      "permanent": true
    }
  ]
}
