{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/dropbox-esignature",
      "destination": "/dropbox-sign",
      "permanent": true
    },
    {
      "source": "/dropbox-esignature/",
      "destination": "/dropbox-sign/",
      "permanent": true
    }
  ]
}
